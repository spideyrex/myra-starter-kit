<script setup lang="ts">
import { Head } from '@inertiajs/vue3';
import { useI18n } from 'vue-i18n';
import AuthenticatedLayout from '@/Layouts/AuthenticatedLayout.vue';
import PageHeader from '@/components/PageHeader.vue';
import { FormFields, ResourceForm } from '@/components/admin';
import { useResourceForm } from '@/composables/useResourceForm';
import { TextInput, Section } from '@/composables/useFormSchema';

const props = defineProps<{
    {{ modelVariable }}: {
        id: number;
        name: string;
    };
}>();

const { t } = useI18n();

const schema = [
    Section.make(t('generated.{{ routePrefix }}.section')).schema([
        TextInput.make('name').label(t('generated.{{ routePrefix }}.columns.name')).required(),
    ]),
];

const { form, submit } = useResourceForm({
    data: {
        name: props.{{ modelVariable }}.name,
    },
    updateRoute: 'admin.{{ routePrefix }}.update',
    updateRouteParams: props.{{ modelVariable }}.id,
    confirm: {
        title: t('generated.{{ routePrefix }}.editTitle'),
        description: t('generated.{{ routePrefix }}.confirmUpdate'),
        confirmText: t('common.save'),
    },
});
</script>

<template>
    <AuthenticatedLayout :breadcrumbs="[
        { label: t('generated.{{ routePrefix }}.title'), href: route('admin.{{ routePrefix }}.index') },
        { label: t('common.edit') },
    ]">
        <Head :title="t('generated.{{ routePrefix }}.editTitle')" />

        <PageHeader
            :title="`${t('generated.{{ routePrefix }}.editTitle')} — ${ {{ modelVariable }}.name }`"
            :description="t('generated.{{ routePrefix }}.editDescription')"
        />

        <ResourceForm
            :processing="form.processing"
            :submit-text="t('common.save')"
            :cancel-href="route('admin.{{ routePrefix }}.index')"
            @submit="submit"
        >
            <FormFields :schema="schema" :form="form" />
        </ResourceForm>
    </AuthenticatedLayout>
</template>
