<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Http\Requests\Admin\Store{{ model }}Request;
use App\Http\Requests\Admin\Update{{ model }}Request;
use App\Models\{{ model }};
use App\Services\{{ model }}Service;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Gate;
use Inertia\Inertia;
use Inertia\Response;

class {{ model }}Controller extends Controller
{
    public function __construct(private readonly {{ model }}Service ${{ modelVariable }}Service) {}

    public function index(Request $request): Response
    {
        Gate::authorize('{{ permissionPrefix }}.view');

        return Inertia::render('Admin/{{ modelPlural }}/Index', [
            '{{ modelPluralVariable }}' => $this->{{ modelVariable }}Service->list($request),
            'filters' => $request->only(['search', 'sort', 'direction']),
        ]);
    }

    public function create(): Response
    {
        Gate::authorize('{{ permissionPrefix }}.create');

        return Inertia::render('Admin/{{ modelPlural }}/Create');
    }

    public function store(Store{{ model }}Request $request): RedirectResponse
    {
        Gate::authorize('{{ permissionPrefix }}.create');

        $this->{{ modelVariable }}Service->create($request->validated());

        return redirect()->route('admin.{{ routePrefix }}.index')->with('success', __('{{ model }} created successfully.'));
    }

    public function edit({{ model }} ${{ modelVariable }}): Response
    {
        Gate::authorize('{{ permissionPrefix }}.edit');

        return Inertia::render('Admin/{{ modelPlural }}/Edit', [
            '{{ modelVariable }}' => ${{ modelVariable }},
        ]);
    }

    public function update(Update{{ model }}Request $request, {{ model }} ${{ modelVariable }}): RedirectResponse
    {
        Gate::authorize('{{ permissionPrefix }}.edit');

        $this->{{ modelVariable }}Service->update(${{ modelVariable }}, $request->validated());

        return redirect()->route('admin.{{ routePrefix }}.index')->with('success', __('{{ model }} updated successfully.'));
    }

    public function destroy({{ model }} ${{ modelVariable }}): RedirectResponse
    {
        Gate::authorize('{{ permissionPrefix }}.delete');

        $this->{{ modelVariable }}Service->delete(${{ modelVariable }});

        return redirect()->route('admin.{{ routePrefix }}.index')->with('success', __('{{ model }} deleted successfully.'));
    }
}
