<?php

namespace Tests\Feature\Modules;

use App\Models\{{ model }};
use App\Models\User;
use Tests\TestCase;

/**
 * Generated by make:myra-resource. Plain PHPUnit on purpose — a generated test
 * must not depend on any optional testing helper.
 */
class {{ model }}ResourceTest extends TestCase
{
    /** @param string[] $abilities */
    private function actorWith(array $abilities): User
    {
        $user = $this->makeUser();
        $user->givePermissionTo($abilities);
        $this->actingAs($user);

        return $user;
    }

    public function test_index_requires_the_view_permission(): void
    {
        $this->actingAsUser();
        $this->get(route('admin.{{ routePrefix }}.index'))->assertForbidden();

        $this->actorWith(['{{ permissionPrefix }}.view']);
        $this->get(route('admin.{{ routePrefix }}.index'))->assertOk();
    }

    public function test_create_requires_the_create_permission(): void
    {
        $this->actorWith(['{{ permissionPrefix }}.view']);
        $this->get(route('admin.{{ routePrefix }}.create'))->assertForbidden();

        $this->actorWith(['{{ permissionPrefix }}.view', '{{ permissionPrefix }}.create']);
        $this->get(route('admin.{{ routePrefix }}.create'))->assertOk();
    }

    public function test_a_non_owner_cannot_see_another_users_row(): void
    {
        $this->actorWith(['{{ permissionPrefix }}.view']);
        {{ model }}::create(['name' => 'Owned by the first actor']);

        $this->actorWith(['{{ permissionPrefix }}.view']);
        $response = $this->get(route('admin.{{ routePrefix }}.index'))->assertOk();

        $rows = $response->viewData('page')['props']['{{ modelPluralVariable }}']['data'];
        $this->assertNotContains('Owned by the first actor', array_column($rows, 'name'));
    }

    public function test_an_unwhitelisted_sort_column_is_ignored(): void
    {
        $this->actorWith(['{{ permissionPrefix }}.view']);
        {{ model }}::create(['name' => 'First']);
        {{ model }}::create(['name' => 'Second']);

        $response = $this->get(route('admin.{{ routePrefix }}.index', [
            'sort' => 'password',
            'direction' => 'asc',
        ]))->assertOk();

        $rows = $response->viewData('page')['props']['{{ modelPluralVariable }}']['data'];
        $this->assertCount(2, $rows);
    }
}
