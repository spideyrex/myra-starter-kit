<?php

namespace App\Http\Controllers\Admin;

use App\Admin\Resource\ParentResource;
use App\Admin\Traits\ResolvesParentResource;
use App\Admin\Traits\SearchableQuery;
use App\Http\Controllers\Controller;
use App\Models\{{ model }};
use App\Models\{{ parentModel }};
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class {{ model }}Controller extends Controller
{
    use ResolvesParentResource, SearchableQuery;

    protected function parentResource(): ParentResource
    {
        return ParentResource::make('{{ parentRoutePrefix }}')
            ->model({{ parentModel }}::class)
            ->relationship('{{ relationship }}')
            ->inverse('{{ inverse }}')
            ->foreignKey('{{ foreignKey }}')
            ->permission('{{ parentPermission }}.view')
            ->titleAttribute('name');
    }

    public function index(Request $request, {{ parentModel }} ${{ inverse }}): Response
    {
        $parent = $this->resolveParent(${{ inverse }});

        return Inertia::render('Admin/{{ modelPlural }}/Index', [
            'parent' => $this->parentPayload($parent),
            'crumbs' => $this->parentBreadcrumbs($parent, 'clusters.{{ routePrefix }}.label'),
            'storeUrl' => $this->childRoute($parent, 'store'),
            '{{ modelPluralVariable }}' => $this->applySearchAndPaginate(
                $this->childQuery($parent),
                $request,
                searchable: ['name'],
                defaultSort: 'created_at',
                sortable: ['id', 'name', 'created_at'],
            ),
            'filters' => $request->only(['search', 'sort', 'direction']),
        ]);
    }

    public function store(Request $request, {{ parentModel }} ${{ inverse }}): RedirectResponse
    {
        $parent = $this->resolveParent(${{ inverse }});

        $validated = $request->validate([
            // TODO: the real rules.
            'name' => ['required', 'string', 'max:255'],
        ]);

        // Through the relation: the foreign key comes from the URL, so a
        // {{ foreignKey }} in the request body cannot reparent the row.
        $this->childRelation($parent)->create($validated);

        return back()->with('success', '{{ model }} created successfully.');
    }

    public function destroy({{ parentModel }} ${{ inverse }}, {{ model }} ${{ modelVariable }}): RedirectResponse
    {
        // Authorises the parent; scopeBindings() already proved the child belongs to it.
        $this->resolveParent(${{ inverse }});

        ${{ modelVariable }}->delete();

        return back()->with('success', '{{ model }} deleted successfully.');
    }
}
