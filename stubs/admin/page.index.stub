<script setup lang="ts">
import { Head, Link } from '@inertiajs/vue3';
import { useI18n } from 'vue-i18n';
import AuthenticatedLayout from '@/Layouts/AuthenticatedLayout.vue';
import DataTable from '@/components/DataTable.vue';
import PageHeader from '@/components/PageHeader.vue';
import { Button } from '@/components/ui/button';
import { TextColumn, DateColumn } from '@/composables/useTableSchema';
import { EditAction, DeleteAction } from '@/composables/useTableActions';
import { usePermissions } from '@/composables/usePermissions';
import type { PaginatedData } from '@/types';
import { Plus } from 'lucide-vue-next';

defineProps<{
    {{ modelPluralVariable }}: PaginatedData<any>;
    filters: Record<string, string>;
}>();

const { can } = usePermissions();
const { t } = useI18n();

const columns = [
    TextColumn.make('name').label(t('generated.{{ routePrefix }}.columns.name')).sortable().searchable(),
    DateColumn.make('created_at').label(t('generated.{{ routePrefix }}.columns.createdAt')).sortable(),
];

const actions = [
    EditAction.make('admin.{{ routePrefix }}.edit').label(t('common.edit')).permission('{{ permissionPrefix }}.edit'),
    DeleteAction.make('admin.{{ routePrefix }}.destroy').label(t('common.delete')).permission('{{ permissionPrefix }}.delete'),
];
</script>

<template>
    <AuthenticatedLayout :breadcrumbs="[{ label: t('generated.{{ routePrefix }}.title') }]">
        <Head :title="t('generated.{{ routePrefix }}.title')" />

        <PageHeader
            :title="t('generated.{{ routePrefix }}.title')"
            :description="t('generated.{{ routePrefix }}.description')"
        >
            <template #actions>
                <Button v-if="can('{{ permissionPrefix }}.create')" as-child>
                    <Link :href="route('admin.{{ routePrefix }}.create')">
                        <Plus class="mr-2 size-4" />
                        {{ t('generated.{{ routePrefix }}.add') }}
                    </Link>
                </Button>
            </template>
        </PageHeader>

        <div class="mt-6">
            <DataTable
                :columns="columns"
                :data="{{ modelPluralVariable }}"
                :filters="filters"
                :actions="actions"
                route-name="admin.{{ routePrefix }}.index"
                table-key="{{ routePrefix }}"
                :search-placeholder="t('generated.{{ routePrefix }}.searchPlaceholder')"
            />
        </div>
    </AuthenticatedLayout>
</template>
